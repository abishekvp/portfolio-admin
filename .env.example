# Copy to .env for local development. In production set these in your host's dashboard.

# --- Server ---
NODE_ENV=development
PORT=4000
# Absolute public URL of this server (used for media links in the portfolio bundle).
# Leave empty to derive it from each request.
PUBLIC_URL=
# Number of reverse proxies in front of the app (Render/Railway/Heroku: 1). Needed for correct client IPs.
TRUST_PROXY=
# Origins allowed to call the public API, comma separated ('*' = any).
# Default '*': any website, from any domain/region, can load the bundle, SDK and media and
# submit forms (no cookies are involved). Restrict with e.g. https://abishek.in,https://www.abishek.in
CORS_ORIGINS=*

# --- Database ---
# PostgreSQL (recommended in production). Leave empty to use an embedded SQLite file (data/portfolio.db).
DATABASE_URL=
# '', 'true', 'false' or 'no-verify' (managed Postgres with self-signed certs)
DATABASE_SSL=

# --- Daily limits & analytics day boundary ---
APP_TIMEZONE=Asia/Kolkata

# --- First admin account (created on startup when no users exist) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Alternatively use the /setup screen; in production it requires this token.
SETUP_TOKEN=

# --- Vercel ---
# Vercel Cron sends this as a Bearer token to /api/cron/daily (midnight cleanup). Any long random string.
CRON_SECRET=
# Upload cap in bytes (defaults to 4 MB on Vercel, whose request limit is 4.5 MB; 15 MB elsewhere).
# MAX_UPLOAD_BYTES=

# --- Sessions ---
# Session length is managed in the admin UI (Account -> Security).
# COOKIE_SECURE defaults to true in production.
# COOKIE_SECURE=

# Images up to this size are inlined (base64) into the public bundle for sessionStorage caching.
INLINE_MEDIA_MAX_BYTES=358400
